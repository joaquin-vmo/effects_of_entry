@article{BORENSTEIN1991,
 ISSN = {07416261},
 URL = {http://www.jstor.org/stable/2601052},
 abstract = {Recent theoretical work has shown that price discrimination can take place in imperfectly competitive, as well as monopoly, markets. The persistence of higher retail margins on unleaded than on leaded gasoline during the 1980s suggests that discrimination may occur even in very competitive markets. This article studies a number of cost-based explanations for such gasoline pricing, as well as the possibility of price discrimination. The analysis indicates that gas stations discriminate against groups of customers who are less likely to switch to another station. The conclusions highlight the influence of shopping or search costs on pricing decisions, even in markets thought to be quite competitive.},
 author = {Severin Borenstein},
 journal = {The RAND Journal of Economics},
 number = {3},
 pages = {354--369},
 publisher = {[RAND Corporation, Wiley]},
 title = {Selling Costs and Switching Costs: Explaining Retail Gasoline Margins},
 urldate = {2026-08-12},
 volume = {22},
 year = {1991}
}

@article{SEN2003,
title = {Higher prices at Canadian gas pumps: international crude oil prices or local market concentration? An empirical investigation},
journal = {Energy Economics},
volume = {25},
number = {3},
pages = {269-288},
year = {2003},
issn = {0140-9883},
doi = {https://doi.org/10.1016/S0140-9883(02)00097-X},
url = {https://www.sciencedirect.com/science/article/pii/S014098830200097X},
author = {Anindya Sen},
keywords = {Gasoline prices, Market structure, Competition},
abstract = {There is little consensus on whether higher retail gasoline prices in Canada are the result of international crude oil price fluctuations or local market power exercised by large vertically-integrated firms. I find that although both increasing local market concentration and higher average monthly wholesale prices are positively and significantly associated with higher retail prices, wholesale prices are more important than local market concentration. Similarly, crude oil prices are more important than the number of local wholesalers in determining wholesale prices. These results suggest that movements in gasoline prices are largely the result of input price fluctuations rather than local market structure.}
}

